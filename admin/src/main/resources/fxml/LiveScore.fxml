<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sportx.controller.LiveScoreController"
      spacing="20" style="-fx-background-color: -fx-base-bg;">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <!-- Header & Match Selection -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="LIVE MATCH CONTROL" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="matchIdField" promptText="Enter Match ID" prefWidth="150"/>
        <Button text="LOAD MATCH" onAction="#loadMatch" styleClass="button, btn-primary"/>
    </HBox>

    <!-- The Live Console Panel -->
    <VBox fx:id="liveConsole" styleClass="content-panel" VBox.vgrow="ALWAYS" visible="false" spacing="30">
        
        <!-- Status Indicator -->
        <HBox alignment="CENTER" spacing="10">
            <Circle fx:id="liveIndicator" radius="6" fill="#FF3B45"/>
            <Label fx:id="matchStatusLabel" text="LIVE" style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: -fx-live-red; -fx-letter-spacing: 2px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="timerLabel" text="00:00" style="-fx-font-size: 24px; -fx-font-family: monospace; -fx-font-weight: bold;"/>
            <Button fx:id="timerToggleBtn" text="Start Timer" onAction="#toggleTimer" styleClass="button"/>
        </HBox>

        <!-- Main Scoreboard -->
        <HBox alignment="CENTER" spacing="50" VBox.vgrow="ALWAYS">
            <!-- Home Team -->
            <VBox alignment="CENTER" spacing="20">
                <Label fx:id="homeTeamName" text="HOME TEAM" style="-fx-font-size: 24px; -fx-font-weight: 900;"/>
                <Label fx:id="homeScoreLabel" text="0" style="-fx-font-size: 96px; -fx-font-weight: 900;"/>
                <HBox spacing="10">
                    <Button text="-1" onAction="#homeMinus" styleClass="button" prefWidth="60" prefHeight="50" style="-fx-font-size: 20px;"/>
                    <Button text="+1 SCORE" onAction="#homePlus" styleClass="button, btn-primary" prefWidth="120" prefHeight="50" style="-fx-font-size: 16px;"/>
                </HBox>
            </VBox>

            <!-- Divider -->
            <Label text="—" style="-fx-font-size: 72px; -fx-text-fill: -fx-text-secondary;"/>

            <!-- Away Team -->
            <VBox alignment="CENTER" spacing="20">
                <Label fx:id="awayTeamName" text="AWAY TEAM" style="-fx-font-size: 24px; -fx-font-weight: 900;"/>
                <Label fx:id="awayScoreLabel" text="0" style="-fx-font-size: 96px; -fx-font-weight: 900;"/>
                <HBox spacing="10">
                    <Button text="+1 SCORE" onAction="#awayPlus" styleClass="button, btn-primary" prefWidth="120" prefHeight="50" style="-fx-font-size: 16px;"/>
                    <Button text="-1" onAction="#awayMinus" styleClass="button" prefWidth="60" prefHeight="50" style="-fx-font-size: 20px;"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- Controls -->
        <HBox alignment="CENTER" spacing="20">
            <padding><Insets top="30" bottom="20"/></padding>
            <Button text="PUBLISH SCORE UPDATE" onAction="#updateScore" styleClass="button, btn-primary" prefHeight="50" style="-fx-font-size: 16px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="END MATCH" onAction="#endMatch" styleClass="button, btn-danger" prefHeight="50"/>
        </HBox>
    </VBox>

</VBox>
