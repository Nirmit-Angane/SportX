<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sportx.controller.QRController"
      spacing="20" style="-fx-background-color: -fx-base-bg;">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="QR CODE GENERATOR" styleClass="page-title"/>

    <HBox spacing="30" VBox.vgrow="ALWAYS">
        <!-- Configuration Panel -->
        <VBox styleClass="content-panel" spacing="20" prefWidth="400">
            <Label text="CONFIGURATION" styleClass="panel-title"/>
            
            <VBox spacing="5">
                <Label text="Target Type"/>
                <ComboBox fx:id="typeSelector" maxWidth="Infinity" onAction="#onTypeSelected"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Select Target"/>
                <ComboBox fx:id="entitySelector" maxWidth="Infinity"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            
            <Button text="GENERATE QR CODE" onAction="#generateQR" styleClass="button, btn-primary" maxWidth="Infinity" prefHeight="45"/>
        </VBox>

        <!-- Preview Panel -->
        <VBox styleClass="content-panel" spacing="20" HBox.hgrow="ALWAYS" alignment="TOP_CENTER">
            <Label text="PREVIEW" styleClass="panel-title" alignment="CENTER_LEFT" maxWidth="Infinity"/>
            
            <VBox fx:id="qrPreviewContainer" alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8px; -fx-padding: 30px;">
                <ImageView fx:id="qrImageView" fitWidth="300" fitHeight="300" preserveRatio="true"/>
                <Label fx:id="qrLabel" text="No Code Generated" style="-fx-text-fill: #333333; -fx-font-weight: bold;"/>
            </VBox>
            
            <Button fx:id="downloadBtn" text="DOWNLOAD PNG" onAction="#downloadQR" styleClass="button" disable="true" maxWidth="300" prefHeight="45"/>
        </VBox>
    </HBox>

</VBox>
