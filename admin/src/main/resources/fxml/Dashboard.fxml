<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sportx.controller.DashboardController"
      spacing="20" style="-fx-background-color: -fx-base-bg;">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Top Statistics Row -->
    <HBox spacing="20">
        <!-- Card 1 -->
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="TOTAL EVENTS" styleClass="stat-title"/>
            <Label fx:id="totalEventsLabel" text="--" styleClass="stat-value"/>
        </VBox>
        <!-- Card 2 -->
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="ACTIVE EVENTS" styleClass="stat-title"/>
            <Label fx:id="activeEventsLabel" text="--" styleClass="stat-value, stat-accent-blue"/>
        </VBox>
        <!-- Card 3 -->
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="UPCOMING MATCHES" styleClass="stat-title"/>
            <Label fx:id="upcomingMatchesLabel" text="--" styleClass="stat-value"/>
        </VBox>
        <!-- Card 4 -->
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" style="-fx-border-color: -fx-live-red; -fx-background-color: rgba(255,59,69,0.05);">
            <HBox alignment="CENTER_LEFT" spacing="5">
                <Circle radius="4" fill="#FF3B45"/>
                <Label text="LIVE MATCHES" styleClass="stat-title, stat-accent-red"/>
            </HBox>
            <Label fx:id="liveMatchesLabel" text="--" styleClass="stat-value, stat-accent-red"/>
        </VBox>
    </HBox>

    <!-- Main Asymmetric Content Area -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Left Column: Live & Activity (Flex 60%) -->
        <VBox spacing="20" HBox.hgrow="ALWAYS" prefWidth="600">
            <!-- Live Matches Panel -->
            <VBox styleClass="content-panel" VBox.vgrow="ALWAYS">
                <Label text="LIVE MATCHES" styleClass="panel-title, stat-accent-red"/>
                <ListView fx:id="liveMatchesList" styleClass="custom-list" VBox.vgrow="ALWAYS"/>
            </VBox>
            
            <!-- Quick Actions Panel -->
            <VBox styleClass="content-panel">
                <Label text="QUICK ACTIONS" styleClass="panel-title"/>
                <FlowPane hgap="10" vgap="10">
                    <Button text="+ Create Event" onAction="#goToCreateEvent" styleClass="button, btn-primary"/>
                    <Button text="+ Add Team" onAction="#goToTeams" styleClass="button"/>
                    <Button text="+ Add Player" onAction="#goToPlayers" styleClass="button"/>
                    <Button text="+ Create Match" onAction="#goToCreateMatch" styleClass="button"/>
                    <Button text="Start Live Score" onAction="#goToLiveScore" styleClass="button"/>
                    <Button text="Generate QR" onAction="#goToQR" styleClass="button"/>
                </FlowPane>
            </VBox>
        </VBox>

        <!-- Right Column: Upcoming Matches (Flex 40%) -->
        <VBox spacing="20" HBox.hgrow="ALWAYS" prefWidth="400">
            <VBox styleClass="content-panel" VBox.vgrow="ALWAYS">
                <Label text="UPCOMING MATCHES" styleClass="panel-title"/>
                <ListView fx:id="upcomingMatchesList" styleClass="custom-list" VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>
    </HBox>

</VBox>
