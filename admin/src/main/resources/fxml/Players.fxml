<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.sportx.controller.PlayerController"
           style="-fx-background-color: -fx-base-bg;">

    <VBox spacing="20" styleClass="content-panel">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="PLAYER MANAGEMENT" styleClass="panel-title" style="-fx-font-size: 16px;"/>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" promptText="Search players..." prefWidth="250"/>
            <Button text="Refresh" onAction="#loadPlayers" styleClass="button"/>
            <Button text="+ ADD PLAYER" onAction="#showCreateForm" styleClass="button, btn-primary"/>
        </HBox>
        
        <TableView fx:id="playersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="60" />
                <TableColumn fx:id="nameCol" text="FULL NAME" prefWidth="250" />
                <TableColumn fx:id="jerseyCol" text="JERSEY NO." prefWidth="100" />
                <TableColumn fx:id="teamCol" text="TEAM" prefWidth="200" />
                <TableColumn fx:id="positionCol" text="POSITION" prefWidth="150" />
                <TableColumn fx:id="statusCol" text="STATUS" prefWidth="100" />
                <TableColumn fx:id="actionsCol" text="ACTIONS" prefWidth="150" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- Create/Edit Form Overlay -->
    <VBox fx:id="formOverlay" style="-fx-background-color: rgba(7,17,31,0.8);" visible="false" alignment="CENTER">
        <VBox styleClass="content-panel" maxWidth="600" spacing="15">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
            <Label fx:id="formTitle" text="ADD PLAYER" styleClass="panel-title" style="-fx-font-size: 18px; -fx-text-fill: -fx-primary-blue;"/>
            
            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Full Name"/>
                    <TextField fx:id="nameInput" promptText="e.g. John Doe"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Jersey Number"/>
                    <TextField fx:id="jerseyInput" promptText="e.g. 10" prefWidth="100"/>
                </VBox>
            </HBox>
            
            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Team"/>
                    <ComboBox fx:id="teamInput" promptText="Select Team" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Position"/>
                    <TextField fx:id="positionInput" promptText="e.g. Forward"/>
                </VBox>
            </HBox>

            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Date of Birth (YYYY-MM-DD)"/>
                    <TextField fx:id="dobInput" promptText="e.g. 1990-01-01"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Status"/>
                    <ComboBox fx:id="statusInput" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <padding><Insets top="20" right="0" bottom="0" left="0"/></padding>
                <Button text="CANCEL" onAction="#hideForm" styleClass="button"/>
                <Button text="SAVE PLAYER" onAction="#savePlayer" styleClass="button, btn-primary"/>
            </HBox>
        </VBox>
    </VBox>

</StackPane>
