<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.sportx.controller.MainController"
           prefHeight="800.0" prefWidth="1280.0">

    <BorderPane>
        <!-- Sidebar -->
        <left>
            <VBox styleClass="sidebar" prefWidth="260.0" spacing="5">
                <padding>
                    <Insets top="0" right="0" bottom="20" left="0"/>
                </padding>
                
                <VBox alignment="CENTER_LEFT">
                    <padding><Insets top="30" right="20" bottom="30" left="25"/></padding>
                    <Label text="SPORTX" styleClass="sidebar-title"/>
                    <Label text="OPERATIONS CENTER" style="-fx-text-fill: -fx-text-secondary; -fx-font-size: 10px; -fx-letter-spacing: 1px;"/>
                </VBox>
                
                <Button fx:id="btnDashboard" text="Dashboard" onAction="#showDashboard" styleClass="sidebar-btn" maxWidth="Infinity">
                    <padding><Insets top="12" right="20" bottom="12" left="25"/></padding>
                </Button>
                <Button fx:id="btnEvents" text="Events" onAction="#showEvents" styleClass="sidebar-btn" maxWidth="Infinity">
                    <padding><Insets top="12" right="20" bottom="12" left="25"/></padding>
                </Button>
                <Button fx:id="btnTeams" text="Teams" onAction="#showTeams" styleClass="sidebar-btn" maxWidth="Infinity">
                    <padding><Insets top="12" right="20" bottom="12" left="25"/></padding>
                </Button>
                <Button fx:id="btnPlayers" text="Players" onAction="#showPlayers" styleClass="sidebar-btn" maxWidth="Infinity">
                    <padding><Insets top="12" right="20" bottom="12" left="25"/></padding>
                </Button>
                <Button fx:id="btnVenues" text="Venues" onAction="#showVenues" styleClass="sidebar-btn" maxWidth="Infinity">
                    <padding><Insets top="12" right="20" bottom="12" left="25"/></padding>
                </Button>
                <Button fx:id="btnMatches" text="Matches" onAction="#showMatches" styleClass="sidebar-btn" maxWidth="Infinity">
                    <padding><Insets top="12" right="20" bottom="12" left="25"/></padding>
                </Button>
                <Button fx:id="btnBrackets" text="Brackets" onAction="#showBrackets" styleClass="sidebar-btn" maxWidth="Infinity">
                    <padding><Insets top="12" right="20" bottom="12" left="25"/></padding>
                </Button>
                <Button fx:id="btnLiveScore" text="Live Score" onAction="#showLiveScore" styleClass="sidebar-btn" maxWidth="Infinity">
                    <padding><Insets top="12" right="20" bottom="12" left="25"/></padding>
                </Button>
                <Button fx:id="btnQRCodes" text="QR Codes" onAction="#showQRCodes" styleClass="sidebar-btn" maxWidth="Infinity">
                    <padding><Insets top="12" right="20" bottom="12" left="25"/></padding>
                </Button>
                
                <Region VBox.vgrow="ALWAYS" />
                
                <Button text="Settings" styleClass="sidebar-btn" maxWidth="Infinity">
                    <padding><Insets top="12" right="20" bottom="12" left="25"/></padding>
                </Button>
                
                <!-- Connection Status -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <padding>
                        <Insets top="20" right="25" bottom="0" left="25"/>
                    </padding>
                    <Circle fx:id="statusDot" radius="4" fill="#22C55E"/>
                    <Label fx:id="statusText" text="API Connected" style="-fx-text-fill: -fx-text-secondary; -fx-font-size: 11px;"/>
                </HBox>
            </VBox>
        </left>
        
        <!-- Main Content Area -->
        <center>
            <VBox style="-fx-background-color: -fx-base-bg;">
                <!-- Top Bar -->
                <HBox fx:id="topBar" styleClass="top-bar" alignment="CENTER_LEFT" prefHeight="70.0">
                    <padding>
                        <Insets right="30" left="30"/>
                    </padding>
                    <Label fx:id="pageTitleLabel" text="Dashboard" styleClass="top-bar-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Admin User" style="-fx-text-fill: -fx-text-secondary; -fx-font-weight: bold;"/>
                    <Circle radius="16" fill="#16243A">
                        <HBox.margin><Insets left="15"/></HBox.margin>
                    </Circle>
                    
                    <HBox alignment="CENTER" spacing="5">
                        <HBox.margin><Insets left="30"/></HBox.margin>
                        <Button fx:id="btnMinimizeWindow" text="−" styleClass="window-control-btn" onAction="#minimizeWindow"/>
                        <Button fx:id="btnMaximizeWindow" text="□" styleClass="window-control-btn" onAction="#maximizeWindow"/>
                        <Button fx:id="btnCloseWindow" text="✕" styleClass="window-control-btn, window-close-btn" onAction="#closeWindow"/>
                    </HBox>
                </HBox>
                
                <!-- Page Content -->
                <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
                    <!-- Views will be injected here -->
                </StackPane>
            </VBox>
        </center>
    </BorderPane>

    <!-- Global Loading Overlay -->
    <VBox fx:id="loadingOverlay" alignment="CENTER" styleClass="loading-overlay" visible="false" spacing="15">
        <ProgressIndicator prefWidth="40" prefHeight="40"/>
        <Label fx:id="loadingLabel" text="Loading..." styleClass="loading-text"/>
    </VBox>

</StackPane>
